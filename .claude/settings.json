{
  "permissions": {
    "deny": [
      "Bash(vercel*--prod*)",
      "Bash(vercel*--target=production*)",
      "Bash(vercel*--target production*)",
      "Bash(vercel*promote*)",
      "Bash(npx vercel*--prod*)",
      "Bash(npx vercel*--target=production*)",
      "Bash(npx vercel*--target production*)",
      "Bash(npx vercel*promote*)",
      "mcp__Vercel__request_promote"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
