# Fictional local/staging values only. Never commit real credentials or use
# this file as a production secret store.
SITE_ORIGIN=http://localhost:3000
TURSO_DATABASE_URL=file:./work/watercooler.db
# TURSO_AUTH_TOKEN=<set-out-of-band-for-remote-turso>
WATERCOOLER_OWNER_EMAIL=owner@example.test

# Optional local helper inputs (the helper also accepts these in the shell):
# PILOT_BASE_URL=http://localhost:3000
# PILOT_ALLOW_REMOTE=no
# PILOT_MODERATOR_EMAIL=moderator@pilot.test
# PILOT_MODERATOR_PASSWORD=fictional-password-at-least-12-chars
# PILOT_ALLOW_MUTATION=yes

# Optional Vercel Cron or external scheduler secret. Hobby pilots can omit it
# and use the moderator Operations panel's deadline check instead.
# CRON_SECRET=<set-out-of-band>

# Remote Preview Playwright runs. Use fictional QA credentials and a secret
# scoped to the exact Preview origin; never put real values in this file.
# E2E_REMOTE=1
# E2E_BASE_URL=https://watercooler-werewolf-preview.example.vercel.app
# E2E_MODERATOR_EMAIL=playwright-owner@e2e.test
# E2E_MODERATOR_PASSWORD=fictional-preview-password-at-least-12-chars
# VERCEL_AUTOMATION_BYPASS_SECRET=<set-out-of-band-for-this-preview-origin>
# E2E_VERCEL_DEPLOYMENT_ID=dpl_<exact-preview-deployment-id>
# E2E_RUN_ID=preview-qa-20260919-a

# Optional invite email over SMTP (see docs/SETUP.md#invite-email). Gmail uses
# smtp.gmail.com with an app password; a domain provider only changes values.
# SMTP_HOST=...
# SMTP_PORT=...
# SMTP_USER=...
# SMTP_PASSWORD=...
# EMAIL_FROM=...
